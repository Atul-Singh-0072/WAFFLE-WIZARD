# systemd unit — keeps Waffle Wizard running and restarts it on crash or reboot.
#
# This server also hosts HM Agri One. Port 3001 is used so the two apps can
# never collide; change it only after checking what is already listening.
#
# Install:  sudo cp deploy/waffle-wizard.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now waffle-wizard

[Unit]
Description=Waffle Wizard website (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/waffle-wizard
Environment=NODE_ENV=production
Environment=PORT=3001
# Bind to loopback only; nginx is the sole public entry point.
Environment=HOSTNAME=127.0.0.1
# Set this to the real site origin so sitemap and share links are correct.
Environment=NEXT_PUBLIC_SITE_URL=https://REPLACE-WITH-YOUR-DOMAIN
# Google Places key — reads the outlet's live rating once a day. Optional: drop
# this line and the site falls back to the snapshot in src/lib/config/site.ts.
# Keep it server-side only; never prefix it with NEXT_PUBLIC_.
Environment=GOOGLE_PLACES_API_KEY=REPLACE-WITH-YOUR-KEY
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
