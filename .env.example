# Copy to .env.local for development; on the VPS these are set in the systemd
# unit (deploy/waffle-wizard.service). Never commit a filled-in copy.

# The public origin — used for sitemap, canonical URLs and share links.
NEXT_PUBLIC_SITE_URL=https://wafflewizard.in

# Google Places API key, used to read the outlet's live rating and review
# count once a day (src/services/google-place.ts).
#
# Optional. Without it the site shows the hand-maintained snapshot in
# src/lib/config/site.ts instead, and nothing breaks.
#
# To create one:
#   1. console.cloud.google.com → create a project
#   2. APIs & Services → Library → enable "Places API (New)"
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. Restrict the key: Application restrictions → None (it is used
#      server-side only, never sent to the browser); API restrictions →
#      "Places API (New)" only. An unrestricted key can be abused if leaked.
#
# One call a day keeps this inside the free allowance.
GOOGLE_PLACES_API_KEY=
